# Browser configuration only. Never put server secrets in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Keep disabled until the correct Stripe account, Tax and webhook pass end-to-end tests.
VITE_CHECKOUT_ENABLED=false
# Optional approved contact-form endpoint. Empty => explicit email fallback.
VITE_CONTACT_ENDPOINT=
