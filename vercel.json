{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/products/:slug", "destination": "/_spa.html" },
    { "source": "/checkout/:path*", "destination": "/_private.html" },
    { "source": "/order-success/:path*", "destination": "/_private.html" },
    { "source": "/login", "destination": "/_private.html" },
    { "source": "/register", "destination": "/_private.html" },
    { "source": "/forgot-password", "destination": "/_private.html" },
    { "source": "/email-verified", "destination": "/_private.html" },
    { "source": "/reset-password", "destination": "/_private.html" },
    { "source": "/dashboard/:path*", "destination": "/_private.html" },
    { "source": "/admin/:path*", "destination": "/_private.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(_spa|_private)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
